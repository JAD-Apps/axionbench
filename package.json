{
  "name": "axionbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "description": "An evidence-led observatory for comparing AI systems.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "prebuild": "node scripts/build-observatory-data.mjs",
    "test:frontier": "node scripts/test-frontier.mjs",
    "verify": "npm run verify:foundation && npm run test:frontier",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "clean:build": "vite build --emptyOutDir",
    "preclean:build": "node scripts/build-observatory-data.mjs",
    "test:unit": "vitest run --exclude \"publication/**\" --exclude \"test-results/**\" --exclude \"tests/project/**\" && node --test tests/project/*.test.mjs",
    "test:registry": "node scripts/test-registry.mjs",
    "test:current-policy": "node scripts/test-current-policy.mjs",
    "data:ingest": "node scripts/ingest-data.mjs",
    "data:validate": "node scripts/data-validate.mjs",
    "test:data": "node scripts/test-data.mjs",
    "test:scoring": "node tests/scoring/test-scoring.mjs",
    "test:chart-smoke": "node scripts/chart-smoke.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "test:authority": "node scripts/test-authority.mjs",
    "test:head-to-head": "node scripts/test-head-to-head.mjs",
    "test:open-weights": "node scripts/test-open-weights.mjs",
    "test:catalogue": "node scripts/test-catalogue.mjs",
    "data:authority": "node scripts/authority/refresh.mjs",
    "lint": "node scripts/lint.mjs",
    "build:release": "node scripts/release/build.mjs",
    "test:browser": "node scripts/chart-smoke.mjs && node scripts/test-browser-runtime.mjs",
    "data:refresh": "node scripts/automation/refresh.mjs",
    "deploy:readback": "node scripts/release/readback.mjs",
    "test:automation": "node scripts/automation/test-automation.mjs",
    "verify:automation": "node scripts/automation/verify-automation.mjs",
    "test:acceptance": "node scripts/test-acceptance.mjs",
    "verify:release": "node scripts/release/verify-release.mjs",
    "jadbot:verify": "npm run verify:release",
    "release:check": "node scripts/release/check-dist.mjs",
    "test:pricing": "node scripts/project/restore-private-price.mjs && node scripts/pricing/verify-private-capture.mjs && node scripts/test-pricing.mjs",
    "test:weights": "node scripts/test-weights.mjs",
    "test:cost-weights": "node scripts/test-cost-weights.mjs",
    "public:prepare": "node scripts/public-snapshot.mjs",
    "verify:public": "node scripts/project/verify-public-boundary.mjs --archive-test",
    "test:public-boundary": "node --test tests/project/public-boundary.test.mjs",
    "test:routes": "node scripts/project/test-routes.mjs",
    "test:core-views": "node scripts/project/test-core-views.mjs",
    "test:cost-version-views": "node scripts/project/test-cost-version-views.mjs",
    "test:cohort-views": "node scripts/project/test-cohort-views.mjs",
    "publish:daily": "node scripts/release/publish.mjs daily",
    "publish:site": "node scripts/release/publish.mjs run",
    "publish:candidate": "node scripts/release/publish.mjs candidate",
    "publish:verify": "node scripts/release/publish.mjs verify",
    "publish:rollback": "node scripts/release/publish.mjs rollback",
    "publish:status": "node scripts/release/publish.mjs status",
    "production:check": "node scripts/release/production-check.mjs",
    "capture:verify": "node scripts/release/verify-capture.mjs",
    "receipts:verify": "node scripts/project/verify-receipts.mjs",
    "public:patches": "node scripts/project/prepare-public-patches.mjs",
    "test:update-transaction": "node --test tests/project/update-transaction.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
